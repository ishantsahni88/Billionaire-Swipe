{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": { "@bill-swipe/shared": ["./packages/shared/src/index.ts"] }
  },
  "include": [
    "packages/shared/src/**/*.ts",
    "backend/src/**/*.ts",
    "backend/tests/**/*.ts"
  ]
}
